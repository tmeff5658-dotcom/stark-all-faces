Face prevFace = FACE_COUNT;                 // FACE_COUNT = none
bool started = false;
unsigned long faceStart = 0, prevStart = 0, transStart = 0, lastFrame = 0;

float gazeX = 0, gazeY = 0, gazeTX = 0, gazeTY = 0;
unsigned long nextGazeAt = 0;

